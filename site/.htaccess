# Site de apresentacao do Wiseller. Este arquivo e versionado e enviado pelo deploy.
RewriteEngine On

# Um unico endereco oficial: https, sem www.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^wiseller\.com\.br$ [NC]
RewriteRule ^ https://wiseller.com.br%{REQUEST_URI} [L,R=301]

# A plataforma mudou para app.wiseller.com.br; os enderecos antigos continuam valendo.
RewriteRule ^(login|criar-conta|request-recover-password|access_log|not-found)(/.*)?$ https://app.wiseller.com.br/$1$2 [L,R=302]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(css|png|ico|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
